---
import { useTranslations } from '../i18n/ui';
import { routes, altLangPath, type RouteKey } from '../i18n/routes';
import { company, type Lang } from '../i18n/config';
import { cms, pick } from '../lib/cms';

interface Props {
  lang: Lang;
  routeKey: RouteKey;
}
const { lang, routeKey } = Astro.props;
const t = useTranslations(lang);

const navItems: { key: RouteKey; label: string }[] = [
  { key: 'home', label: t.nav.home },
  { key: 'about', label: t.nav.about },
  { key: 'works', label: t.nav.works },
  { key: 'equipment', label: t.nav.equipment },
  { key: 'technical', label: t.nav.technical },
  { key: 'contact', label: t.nav.contact },
];

const otherLangHref = altLangPath(routeKey, lang);
const otherLang: Lang = lang === 'sr' ? 'en' : 'sr';
const logoHref = routes.home[lang];

// Optional site-wide announcement (admin → Obaveštenje), e.g. holiday hours.
const ann = cms.announcement?.enabled ? cms.announcement : null;
const annText = ann ? pick(ann.text, lang) : '';
const annLabel = ann ? pick(ann.linkLabel, lang) || (lang === 'sr' ? 'Saznajte više' : 'Learn more') : '';
const annExternal = !!ann?.link && /^https?:/i.test(ann.link);
// Dismissal is remembered per announcement text.
const annId = annText ? String([...annText].reduce((h, c) => (h * 31 + c.charCodeAt(0)) | 0, 7)) : '';
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-ink-900/30 backdrop-blur-md transition-all duration-300"
  data-header
>
  {
    annText && (
      <div class="bg-accent text-white" data-announcement={annId}>
        <div class="container-px flex items-center justify-center gap-3 py-2 text-center text-xs sm:text-sm">
          <p>
            {annText}
            {ann?.link && (
              <a href={ann.link} class="ml-1 font-semibold underline" target={annExternal ? '_blank' : undefined} rel={annExternal ? 'noopener' : undefined}>
                {annLabel}
              </a>
            )}
          </p>
          <button type="button" class="shrink-0 text-white/80 hover:text-white" aria-label={lang === 'sr' ? 'Zatvori obaveštenje' : 'Close announcement'} data-announcement-close>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
          </button>
        </div>
      </div>
    )
  }
  <div class="container-px flex items-center justify-between py-4">
    <!-- Logo (always the white wordmark — bar is always dark glass) -->
    <a href={logoHref} class="relative z-10 flex items-center" aria-label="Algreen">
      <img
        src="/img/logo-white.png"
        alt="Algreen"
        width="140"
        height="40"
        class="h-9 w-auto"
      />
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-7 lg:flex" aria-label="Glavni meni">
      {
        navItems.map((item) => (
          <a
            href={routes[item.key][lang]}
            class:list={[
              'relative text-xs font-medium uppercase tracking-wider transition-colors hover:text-accent-light after:absolute after:-bottom-1.5 after:left-0 after:h-px after:bg-accent after:transition-all after:duration-300',
              routeKey === item.key ? 'text-accent-light after:w-full' : 'text-white/90 after:w-0 hover:after:w-full',
            ]}
            data-nav-link
            aria-current={routeKey === item.key ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={company.configurator}
        target="_blank"
        rel="noopener"
        class="rounded bg-accent px-4 py-2 text-xs font-semibold uppercase tracking-wide text-white transition-colors hover:bg-accent-light"
      >
        {t.nav.configurator}
      </a>
    </nav>

    <div class="flex items-center gap-3">
      <!-- Language switcher -->
      <a
        href={otherLangHref}
        class="hidden rounded-full border border-white/40 bg-white/10 px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-white backdrop-blur-sm transition-colors hover:bg-white hover:text-ink-900 lg:inline-block"
        data-lang-switch
        hreflang={otherLang}
      >
        {otherLang.toUpperCase()}
      </a>

      <!-- Mobile menu button -->
      <button
        type="button"
        class="relative z-[60] flex h-10 w-10 items-center justify-center rounded-md text-white lg:hidden"
        aria-label={t.common.menu}
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="sr-only">{t.common.menu}</span>
        <svg class="h-6 w-6" data-icon-open fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg class="hidden h-6 w-6" data-icon-close fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

</header>

<!-- Mobile menu panel — kept OUTSIDE <header> so its `position: fixed` is
     relative to the viewport, not the backdrop-filtered header (which would
     otherwise become the containing block and shrink the panel to the bar). -->
<div
  id="mobile-menu"
  class="invisible fixed inset-0 z-[80] flex translate-x-full flex-col bg-[#161313] px-6 pb-10 pt-24 text-white transition-transform duration-300 ease-in-out lg:hidden"
  data-mobile-menu
>
  <button
    type="button"
    class="absolute right-4 top-4 flex h-10 w-10 items-center justify-center rounded-md text-white"
    aria-label={t.common.menu}
    data-menu-close
  >
    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>
  <nav class="flex flex-col gap-1" aria-label="Mobilni meni">
    {
      navItems.map((item) => (
        <a
          href={routes[item.key][lang]}
          class:list={[
            'border-b border-white/10 py-4 text-lg font-medium uppercase tracking-wide',
            routeKey === item.key ? 'text-accent-light' : 'text-white',
          ]}
        >
          {item.label}
        </a>
      ))
    }
    <a
      href={company.configurator}
      target="_blank"
      rel="noopener"
      class="mt-4 inline-flex w-fit rounded bg-accent px-6 py-3 text-base font-semibold uppercase tracking-wide text-white"
    >
      {t.nav.configurator}
    </a>
  </nav>
  <a
    href={otherLangHref}
    class="mt-8 inline-flex w-fit rounded-full border border-white/40 px-5 py-2 text-sm font-semibold uppercase tracking-wider"
    hreflang={otherLang}
  >
    {otherLang === 'sr' ? 'Srpski' : 'English'} ({otherLang.toUpperCase()})
  </a>
</div>

<script>
  const header = document.querySelector('[data-header]') as HTMLElement | null;
  const toggle = document.querySelector('[data-menu-toggle]') as HTMLButtonElement | null;
  const menu = document.querySelector('[data-mobile-menu]') as HTMLElement | null;
  const iconOpen = document.querySelector('[data-icon-open]') as SVGElement | null;
  const iconClose = document.querySelector('[data-icon-close]') as SVGElement | null;

  let menuOpen = false;

  function setMenu(open: boolean) {
    menuOpen = open;
    if (!menu || !toggle) return;
    menu.classList.toggle('translate-x-full', !open);
    menu.classList.toggle('invisible', !open);
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  }

  toggle?.addEventListener('click', () => setMenu(!menuOpen));
  document.querySelector('[data-menu-close]')?.addEventListener('click', () => setMenu(false));

  // Persistent dark frosted-glass bar (white text always). Just deepens the
  // tint + adds a shadow once you scroll past the top — no color/logo flip.
  function onScroll() {
    if (!header) return;
    const scrolled = window.scrollY > 30;
    header.classList.toggle('bg-ink-900/30', !scrolled);
    header.classList.toggle('bg-ink-900/80', scrolled);
    header.classList.toggle('shadow-lg', scrolled);
    header.classList.toggle('shadow-ink-900/20', scrolled);
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Announcement bar (only rendered when published from the admin).
  const ann = document.querySelector('[data-announcement]') as HTMLElement | null;
  if (ann) {
    const key = 'algreen-ann-' + ann.dataset.announcement;
    try {
      if (localStorage.getItem(key)) ann.remove();
    } catch {}
    document.querySelector('[data-announcement-close]')?.addEventListener('click', () => {
      ann.remove();
      try {
        localStorage.setItem(key, '1');
      } catch {}
    });
  }
</script>
