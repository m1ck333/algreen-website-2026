---
import { useTranslations } from '../i18n/ui';
import { path } from '../i18n/routes';
import { type Lang } from '../i18n/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// FAQPage structured data — makes the Q&A eligible for rich results in search.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.faq.items.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section class="bg-ink-800 py-20 sm:py-28">
  <div class="container-px">
    <div class="mx-auto max-w-2xl text-center reveal">
      <h2 class="text-3xl font-bold uppercase tracking-tight text-white sm:text-4xl">{t.faq.heading}</h2>
      <p class="mt-4 text-white/60">{t.faq.subheading}</p>
    </div>

    <div class="mx-auto mt-10 max-w-3xl divide-y divide-white/10 reveal" data-delay="1">
      {
        t.faq.items.map((item) => (
          <details class="group py-2">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-lg font-medium text-white transition-colors hover:text-accent-light [&::-webkit-details-marker]:hidden">
              {item.q}
              <svg class="h-5 w-5 shrink-0 text-accent transition-transform duration-300 group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
            </summary>
            <p class="pb-5 pr-8 leading-relaxed text-white/70">{item.a}</p>
          </details>
        ))
      }
    </div>

    <div class="mt-10 text-center reveal">
      <a href={path('contact', lang)} class="btn-outline border-white/25 text-white hover:border-accent hover:text-accent">
        {t.common.contactUs}
      </a>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>
