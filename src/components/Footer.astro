---
import { useTranslations } from '../i18n/ui';
import { routes, type RouteKey } from '../i18n/routes';
import { company, type Lang } from '../i18n/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const navItems: { key: RouteKey; label: string }[] = [
  { key: 'about', label: t.nav.about },
  { key: 'works', label: t.nav.works },
  { key: 'equipment', label: t.nav.equipment },
  { key: 'technical', label: t.nav.technical },
  { key: 'contact', label: t.nav.contact },
];

const txt = (v: string | Record<Lang, string>) => (typeof v === 'string' ? v : v[lang]);

// WhatsApp — built from the first branch's mobile number (digits only).
const whatsapp = 'https://wa.me/' + company.branches[0].phones[1].replace(/[^\d]/g, '');
---

<footer class="bg-ink-900 text-white/80">
  <div class="container-px grid gap-12 py-16 md:grid-cols-2 lg:grid-cols-4">
    <!-- Brand -->
    <div class="lg:col-span-1">
      <img src="/img/logo-white.png" alt="Algreen" width="150" height="42" class="h-10 w-auto" />
      <p class="mt-5 max-w-xs text-sm leading-relaxed text-white/60">
        {t.home.heroSubtitle}
      </p>
      <div class="mt-6 flex gap-3">
        <a
          href={company.socials.facebook}
          target="_blank"
          rel="noopener"
          aria-label="Facebook"
          class="flex h-10 w-10 items-center justify-center rounded-full border border-white/20 transition-colors hover:border-accent hover:text-accent-light"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"
            ><path
              d="M9 8H6v4h3v12h5V12h3.642L18 8h-4V6.333C14 5.378 14.192 5 15.115 5H18V0h-3.808C10.596 0 9 1.583 9 4.615V8z"
            ></path></svg
          >
        </a>
        <a
          href={company.socials.instagram}
          target="_blank"
          rel="noopener"
          aria-label="Instagram"
          class="flex h-10 w-10 items-center justify-center rounded-full border border-white/20 transition-colors hover:border-accent hover:text-accent-light"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"
            ><path
              d="M12 2.2c3.2 0 3.6 0 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.43.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s0 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.43.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58 0-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 01-1.38-.9 3.7 3.7 0 01-.9-1.38c-.16-.43-.36-1.06-.41-2.23C2.21 15.58 2.2 15.2 2.2 12s0-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.43-.16 1.06-.36 2.23-.41C8.42 2.21 8.8 2.2 12 2.2zm0 3.3a6.5 6.5 0 100 13 6.5 6.5 0 000-13zm0 10.7a4.2 4.2 0 110-8.4 4.2 4.2 0 010 8.4zm6.4-10.9a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"
            ></path></svg
          >
        </a>
        <a
          href={whatsapp}
          target="_blank"
          rel="noopener"
          aria-label="WhatsApp"
          class="flex h-10 w-10 items-center justify-center rounded-full border border-white/20 transition-colors hover:border-accent hover:text-accent-light"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"
            ><path
              d="M17.5 14.4c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.77-.72 2.02-1.42.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35zM12 2a10 10 0 00-8.5 15.3L2 22l4.8-1.26A10 10 0 1012 2z"
            ></path></svg
          >
        </a>
      </div>
    </div>

    <!-- Quick links -->
    <nav aria-label="Footer" class="lg:col-span-1">
      <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-white">Algreen</h3>
      <ul class="space-y-2.5 text-sm">
        {
          navItems.map((item) => (
            <li>
              <a href={routes[item.key][lang]} class="transition-colors hover:text-accent-light">
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={company.configurator} target="_blank" rel="noopener" class="text-accent-light transition-colors hover:text-accent">
            {t.nav.configurator}
          </a>
        </li>
      </ul>
    </nav>

    <!-- Branches -->
    {
      company.branches.map((b) => (
        <div>
          <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-white">
            {t.contact.branchOffice} {txt(b.city)}
          </h3>
          <address class="space-y-2.5 text-sm not-italic text-white/70">
            <p>{txt(b.street)}</p>
            <p>{txt(b.postal)}</p>
            {b.phones.map((p) => (
              <p>
                <a href={`tel:${p.replace(/[^+\d]/g, '')}`} class="transition-colors hover:text-accent-light">
                  {p}
                </a>
              </p>
            ))}
            <p>
              <a href={`mailto:${company.email}`} class="transition-colors hover:text-accent-light">
                {company.email}
              </a>
            </p>
          </address>
        </div>
      ))
    }
  </div>

  <div class="border-t border-white/10">
    <div class="container-px flex flex-col items-center justify-between gap-3 py-6 pb-24 text-xs text-white/50 sm:flex-row lg:pb-6">
      <p>© {year} {company.legalName}. {t.common.allRights}</p>
      <p>Bulevar Svetog Cara Konstantina 168, Niš · Beograd-Zemun</p>
    </div>
  </div>
</footer>
