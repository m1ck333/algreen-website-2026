---
import { useTranslations } from '../../i18n/ui';
import { type Lang } from '../../i18n/config';
import { img } from '../../lib/slots';
import { galleryPhotos } from '../../lib/gallery';
import PageHero from '../PageHero.astro';
import CtaBand from '../CtaBand.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// Door project photos — managed by the client in /admin → Naši radovi (order,
// captions, uploads); falls back to the built-in legacy set (src/lib/gallery.ts).
// Grid thumbnails use a small variant via srcset; the full image is kept for the
// lightbox. Captions become the alt text (and show in the lightbox).
const gallery = galleryPhotos(lang);
const hasCaptions = gallery.some((p) => p.caption);
---

<PageHero title={t.works.title} subtitle={t.works.subtitle} eyebrow={t.nav.works} image={img('hero.works')} />

<section class="section">
  <div class="container-px">
    <p class="mx-auto mb-12 max-w-2xl text-center text-lg leading-relaxed text-white/70 reveal">{t.works.intro}</p>

    <div class="columns-2 gap-4 sm:columns-3 lg:columns-4 [&>*]:mb-4">
      {
        gallery.map((p, i) => (
          <button
            type="button"
            class="group block w-full overflow-hidden rounded-xl bg-white/5 reveal"
            data-lightbox-trigger
            data-src={p.full}
            data-caption={p.caption || undefined}
            aria-label={p.caption || `${t.works.title} ${i + 1}`}
          >
            <img
              src={p.src}
              srcset={p.srcset}
              sizes="(min-width: 1024px) 300px, (min-width: 640px) 33vw, 50vw"
              alt={p.caption ? `${p.caption} — Algreen` : `${t.works.title} ${i + 1} — Algreen`}
              loading="lazy"
              decoding="async"
              class="w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          </button>
        ))
      }
    </div>
  </div>
</section>

<!-- Lightbox -->
<div
  id="lightbox"
  class="fixed inset-0 z-[80] hidden items-center justify-center bg-ink-900/95 p-4"
  data-lightbox
>
  <button type="button" class="absolute right-5 top-5 text-white/80 transition-colors hover:text-white" data-lightbox-close aria-label="Close">
    <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
  </button>
  <button type="button" class="absolute left-4 text-white/70 transition-colors hover:text-white sm:left-8" data-lightbox-prev aria-label="Previous">
    <svg class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
  </button>
  {
    hasCaptions ? (
      <figure class="flex flex-col items-center">
        <img src="" alt="" class="max-h-[80vh] max-w-[90vw] rounded-lg object-contain" data-lightbox-img />
        <figcaption class="mt-3 max-w-[90vw] text-center text-sm text-white/80" data-lightbox-caption></figcaption>
      </figure>
    ) : (
      <img src="" alt="" class="max-h-[85vh] max-w-[90vw] rounded-lg object-contain" data-lightbox-img />
    )
  }
  <button type="button" class="absolute right-4 text-white/70 transition-colors hover:text-white sm:right-8" data-lightbox-next aria-label="Next">
    <svg class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
  </button>
</div>

<CtaBand lang={lang} variant="contact" />

<script>
  const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-lightbox-trigger]'));
  const box = document.querySelector('[data-lightbox]') as HTMLElement | null;
  const boxImg = document.querySelector('[data-lightbox-img]') as HTMLImageElement | null;
  const closeBtn = document.querySelector('[data-lightbox-close]') as HTMLButtonElement | null;
  const boxCaption = document.querySelector('[data-lightbox-caption]') as HTMLElement | null;
  const srcs = triggers.map((t) => t.dataset.src || '');
  let current = 0;
  let lastFocused: HTMLElement | null = null;

  // Focusable controls inside the lightbox, for a simple focus trap.
  const controls = () =>
    Array.from(box?.querySelectorAll<HTMLElement>('button') ?? []);

  function open(i: number, rememberFocus = false) {
    if (!box || !boxImg) return;
    if (rememberFocus) lastFocused = document.activeElement as HTMLElement;
    current = (i + srcs.length) % srcs.length;
    boxImg.src = srcs[current];
    boxImg.alt = triggers[current].dataset.caption || '';
    if (boxCaption) boxCaption.textContent = triggers[current].dataset.caption || '';
    box.classList.remove('hidden');
    box.classList.add('flex');
    document.body.style.overflow = 'hidden';
    closeBtn?.focus();
  }
  function close() {
    if (!box) return;
    box.classList.add('hidden');
    box.classList.remove('flex');
    document.body.style.overflow = '';
    lastFocused?.focus();
  }

  triggers.forEach((t, i) => t.addEventListener('click', () => open(i, true)));
  closeBtn?.addEventListener('click', close);
  document.querySelector('[data-lightbox-next]')?.addEventListener('click', () => open(current + 1));
  document.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => open(current - 1));
  box?.addEventListener('click', (e) => {
    if (e.target === box) close();
  });
  document.addEventListener('keydown', (e) => {
    if (box?.classList.contains('hidden')) return;
    if (e.key === 'Escape') close();
    else if (e.key === 'ArrowRight') open(current + 1);
    else if (e.key === 'ArrowLeft') open(current - 1);
    else if (e.key === 'Tab') {
      // Trap focus within the lightbox controls
      const items = controls();
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      const active = document.activeElement;
      if (e.shiftKey && active === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && active === last) {
        e.preventDefault();
        first.focus();
      } else if (!items.includes(active as HTMLElement)) {
        e.preventDefault();
        first.focus();
      }
    }
  });
</script>
