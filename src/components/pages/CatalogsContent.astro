---
import { useTranslations } from '../../i18n/ui';
import { type Lang } from '../../i18n/config';
import { img } from '../../lib/slots';
import { catalogs } from '../../lib/catalogs';
import PageHero from '../PageHero.astro';
import CtaBand from '../CtaBand.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const c = t.catalogs;
const items = catalogs(lang);
const many = items.length > 1;
// More than 4 catalogs: covers only in the thumbnail row (titles as tooltips) so it stays
// one line on desktop; phones get a "03 / 10" counter between the arrows instead.
const compact = items.length > 4;
const pad = (n: number) => String(n).padStart(2, '0');
---

<PageHero title={c.title} subtitle={c.subtitle} eyebrow={t.nav.catalogs} image={img('hero.catalogs')} />

<!--
  One slider, one catalog per slide — laid out like the homepage "Kreirajte svoja vrata"
  section (text left, cover right). Every slide is in the static HTML (SEO). The track is
  NOT a scroll container (it's moved with a transform), so the mouse wheel / trackpad
  always scrolls the page. Navigation: ‹ › arrows beside the thumbnails, thumbnails,
  swipe, ← → (no wrap-around; autoplay plays through once and stops at the last).
  Gentle autoplay with a progress line shows it's a slider; it stops for good on the
  first interaction and is off with prefers-reduced-motion.
-->
<section class="bg-ink-900 py-20 text-white sm:py-28" data-slider aria-roledescription="carousel" aria-label={c.title}>
  <div class="container-px">
    <div class="overflow-hidden" data-viewport>
      <div class="flex transition-transform duration-700 ease-[cubic-bezier(.22,.61,.36,1)]" data-track>
        {
          items.map((cat, i) => (
            <article class="w-full shrink-0" aria-roledescription="slide" aria-label={`${i + 1} / ${items.length}`} data-slide>
              <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-12">
                <div>
                  <p class="eyebrow">
                    {c.kicker} {pad(i + 1)} / {pad(items.length)}
                  </p>
                  <h2 class="text-4xl font-bold uppercase leading-[1.05] tracking-tight sm:text-5xl">{cat.title}</h2>
                  {cat.text && <p class="mt-6 max-w-lg leading-relaxed text-white/70">{cat.text}</p>}
                  <a href={cat.href} target="_blank" rel="noopener" class="btn-primary mt-9">
                    {c.download}
                    <span class="ml-2 text-xs">PDF</span>
                  </a>
                </div>
                <div class="relative mx-auto w-full max-w-xl">
                  <a href={cat.href} target="_blank" rel="noopener" class="group block overflow-hidden rounded" tabindex="-1" aria-hidden="true">
                    <img
                      src={cat.cover.src}
                      srcset={cat.cover.srcset}
                      sizes={cat.cover.srcset && '(min-width: 1024px) 45vw, 100vw'}
                      alt=""
                      loading={i === 0 ? 'eager' : 'lazy'}
                      decoding="async"
                      draggable="false"
                      class="aspect-square w-full select-none object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
                    />
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>

    {
      many && (
        <>
          <!-- Thumbnails: every catalog at a glance, the active one in red -->
          <div class="mt-14 flex items-center justify-center gap-2 sm:gap-5">
          <button type="button" class="slider-arrow" data-prev aria-label={c.prev}>
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
          </button>
          {compact && (
            <span class="min-w-[5rem] text-center text-sm font-semibold tracking-[0.2em] text-white/80 sm:hidden" data-counter aria-hidden="true">
              01 / {pad(items.length)}
            </span>
          )}
          <div class:list={['flex-wrap justify-center gap-2 sm:gap-4', compact ? 'hidden sm:flex' : 'flex']} role="tablist" aria-label={c.title}>
            {items.map((cat, i) => (
              <button type="button" role="tab" class="thumb" title={cat.title} data-thumb={i} aria-selected={i === 0 ? 'true' : 'false'} aria-label={cat.title}>
                <img src={cat.cover.src} alt="" loading="lazy" decoding="async" class="h-11 w-11 shrink-0 rounded object-cover sm:h-16 sm:w-16" />
                {!compact && <span class="hidden max-w-[11rem] text-left text-xs font-semibold uppercase leading-snug tracking-wider sm:block">{cat.title}</span>}
                <span class="thumb-bar" aria-hidden="true"><span /></span>
              </button>
            ))}
          </div>
          <button type="button" class="slider-arrow" data-next aria-label={c.next}>
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </button>
          </div>
        </>
      )
    }
  </div>
</section>

<CtaBand lang={lang} variant="configurator" />

<style>
  [data-track] {
    touch-action: pan-y; /* vertical swipes scroll the page, horizontal ones change slides */
  }
  .slider-arrow {
    display: inline-flex;
    flex-shrink: 0;
    height: 2.75rem;
    width: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid rgb(255 255 255 / 0.25);
    color: #fff;
    transition: border-color 0.2s, background 0.2s, opacity 0.2s;
  }
  .slider-arrow:hover {
    border-color: #e01f26;
    background: #e01f26;
  }
  .slider-arrow:disabled {
    opacity: 0.25;
    pointer-events: none;
  }
  .thumb {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    overflow: hidden;
    border-radius: 0.5rem;
    padding: 0.3rem;
    color: rgb(255 255 255 / 0.55);
    background: rgb(255 255 255 / 0.04);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
    transition: color 0.2s, background 0.2s, box-shadow 0.2s;
  }
  @media (min-width: 640px) {
    .thumb {
      padding: 0.5rem;
    }
  }
  .thumb:hover {
    color: #fff;
    background: rgb(255 255 255 / 0.08);
  }
  .thumb img {
    opacity: 0.6;
    transition: opacity 0.2s;
  }
  .thumb[aria-selected='true'] {
    color: #fff;
    background: rgb(255 255 255 / 0.08);
    box-shadow: inset 0 0 0 2px #e01f26;
  }
  .thumb[aria-selected='true'] img,
  .thumb:hover img {
    opacity: 1;
  }
  .thumb-bar {
    position: absolute;
    inset: auto 0 0 0;
    height: 3px;
  }
  .thumb-bar > span {
    display: block;
    height: 100%;
    width: 0;
    background: #e01f26;
  }
  .thumb.playing .thumb-bar > span {
    animation: thumb-progress var(--autoplay, 7s) linear forwards;
  }
  [data-slider].paused .thumb.playing .thumb-bar > span {
    animation-play-state: paused;
  }
  @keyframes thumb-progress {
    to {
      width: 100%;
    }
  }
</style>

<script>
  const AUTOPLAY_MS = 7000;

  document.querySelectorAll<HTMLElement>('[data-slider]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]');
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    if (!track || slides.length < 2) return;
    const thumbs = [...root.querySelectorAll<HTMLButtonElement>('[data-thumb]')];
    const counter = root.querySelector<HTMLElement>('[data-counter]');
    const prevs = [...root.querySelectorAll<HTMLButtonElement>('[data-prev]')];
    const nexts = [...root.querySelectorAll<HTMLButtonElement>('[data-next]')];
    let current = 0;

    const render = () => {
      track.style.transform = `translateX(-${current * 100}%)`;
      slides.forEach((s, i) => {
        const on = i === current;
        s.toggleAttribute('inert', !on); // off-screen slides: not focusable / not read out
        s.setAttribute('aria-hidden', String(!on));
      });
      thumbs.forEach((b, i) => {
        b.setAttribute('aria-selected', String(i === current));
        b.classList.remove('playing');
      });
      if (counter) counter.textContent = `${String(current + 1).padStart(2, '0')} / ${String(slides.length).padStart(2, '0')}`;
      prevs.forEach((b) => (b.disabled = current === 0));
      nexts.forEach((b) => (b.disabled = current === last));
    };
    const last = slides.length - 1;
    const go = (i: number) => {
      current = Math.max(0, Math.min(last, i));
      render();
    };

    // --- autoplay (wrap-around); stops for good on the first interaction
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let auto = !reduced;
    let timer = 0;
    let started = 0;
    let left = AUTOPLAY_MS;
    const schedule = () => {
      clearTimeout(timer);
      if (current === last) auto = false; // plays through once, never jumps back to the start
      if (!auto) return;
      const thumb = thumbs[current];
      if (thumb) {
        thumb.classList.remove('playing');
        void thumb.offsetWidth; // restart the progress animation
        thumb.style.setProperty('--autoplay', `${AUTOPLAY_MS}ms`);
        thumb.classList.add('playing');
      }
      started = Date.now();
      left = AUTOPLAY_MS;
      timer = window.setTimeout(() => {
        go(current + 1);
        schedule();
      }, AUTOPLAY_MS);
    };
    const stop = () => {
      auto = false;
      clearTimeout(timer);
      thumbs.forEach((b) => b.classList.remove('playing'));
    };
    // Pause while the pointer is over the slider (progress line freezes too).
    root.addEventListener('mouseenter', () => {
      if (!auto) return;
      clearTimeout(timer);
      left = Math.max(0, left - (Date.now() - started));
      root.classList.add('paused');
    });
    root.addEventListener('mouseleave', () => {
      if (!auto) return;
      root.classList.remove('paused');
      started = Date.now();
      timer = window.setTimeout(() => {
        go(current + 1);
        schedule();
      }, left);
    });

    const user = (i: number) => {
      stop();
      go(i);
    };
    prevs.forEach((b) => b.addEventListener('click', () => user(current - 1)));
    nexts.forEach((b) => b.addEventListener('click', () => user(current + 1)));
    thumbs.forEach((b, i) => b.addEventListener('click', () => user(i)));
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') user(current - 1);
      if (e.key === 'ArrowRight') user(current + 1);
    });

    // --- swipe (touch / pen); the wheel is never captured
    let x0 = 0;
    let y0 = 0;
    let tracking = false;
    track.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse') return;
      tracking = true;
      x0 = e.clientX;
      y0 = e.clientY;
    });
    track.addEventListener('pointerup', (e) => {
      if (!tracking) return;
      tracking = false;
      const dx = e.clientX - x0;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(e.clientY - y0)) {
        user(dx < 0 ? current + 1 : current - 1); // clamped: no wrap-around
      }
    });
    track.addEventListener('pointercancel', () => (tracking = false));

    // Start autoplay only once the slider is actually on screen.
    render();
    if (auto) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((en) => en.isIntersecting)) {
          io.disconnect();
          schedule();
        }
      }, { threshold: 0.4 });
      io.observe(root);
    }
  });
</script>
