---
import { useTranslations } from '../../i18n/ui';
import { type Lang } from '../../i18n/config';
import { img } from '../../lib/slots';
import { catalogs } from '../../lib/catalogs';
import PageHero from '../PageHero.astro';
import CtaBand from '../CtaBand.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const c = t.catalogs;
const items = catalogs(lang);
const pad = (n: number) => String(n).padStart(2, '0');
---

<PageHero title={c.title} subtitle={c.subtitle} eyebrow={t.nav.catalogs} image={img('hero.catalogs')} />

<!--
  One slider, one catalog per slide — laid out like the homepage "Kreirajte svoja vrata"
  section (text left, cover right). Plain scroll-snap: every slide is in the static HTML
  (SEO), swipe works natively on phones; the script only drives the arrows + dots.
-->
<section class="bg-ink-900 py-20 text-white sm:py-28" data-slider>
  <div class="container-px">
    <div class="no-scrollbar flex snap-x snap-mandatory overflow-x-auto scroll-smooth" data-track tabindex="0" aria-label={c.title}>
      {
        items.map((cat, i) => (
          <article class="w-full shrink-0 snap-center" aria-roledescription="slide" aria-label={`${i + 1} / ${items.length}`}>
            <div class="grid items-center gap-12 lg:grid-cols-2">
              <div>
                <p class="eyebrow text-accent">
                  {c.kicker} {pad(i + 1)} / {pad(items.length)}
                </p>
                <h2 class="text-4xl font-bold uppercase leading-[1.05] tracking-tight sm:text-5xl">{cat.title}</h2>
                {cat.text && <p class="mt-6 max-w-lg leading-relaxed text-white/70">{cat.text}</p>}
                <a href={cat.href} target="_blank" rel="noopener" class="btn-primary mt-9">
                  {c.download}
                  <span class="ml-2 text-xs opacity-80">PDF</span>
                </a>
              </div>
              <a href={cat.href} target="_blank" rel="noopener" class="group block" tabindex="-1" aria-hidden="true">
                <img
                  src={cat.cover.src}
                  srcset={cat.cover.srcset}
                  sizes={cat.cover.srcset && '(min-width: 1024px) 45vw, 100vw'}
                  alt=""
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  class="mx-auto aspect-square w-full max-w-xl rounded object-cover transition-transform duration-700 ease-out group-hover:scale-[1.02]"
                />
              </a>
            </div>
          </article>
        ))
      }
    </div>

    {
      items.length > 1 && (
        <div class="mt-12 flex items-center justify-center gap-6">
          <button type="button" class="slider-btn" data-prev aria-label={c.prev}>
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
          </button>
          <div class="flex items-center gap-2.5">
            {items.map((cat, i) => (
              <button type="button" class="slider-dot" data-dot={i} aria-label={cat.title} aria-current={i === 0 ? 'true' : undefined} />
            ))}
          </div>
          <button type="button" class="slider-btn" data-next aria-label={c.next}>
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </button>
        </div>
      )
    }
  </div>
</section>

<CtaBand lang={lang} variant="configurator" />

<style>
  .no-scrollbar {
    scrollbar-width: none;
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .slider-btn {
    display: inline-flex;
    height: 2.75rem;
    width: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid rgb(255 255 255 / 0.25);
    color: #fff;
    transition: border-color 0.2s, color 0.2s, opacity 0.2s;
  }
  .slider-btn:hover {
    border-color: #e01f26;
    color: #e01f26;
  }
  .slider-btn:disabled {
    opacity: 0.3;
    pointer-events: none;
  }
  .slider-dot {
    height: 0.5rem;
    width: 0.5rem;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.3);
    transition: width 0.3s, background 0.3s;
  }
  .slider-dot[aria-current='true'] {
    width: 1.75rem;
    background: #e01f26;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-slider]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]');
    if (!track) return;
    const slides = [...track.children] as HTMLElement[];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    let current = 0;

    const go = (i: number) => {
      const n = Math.max(0, Math.min(slides.length - 1, i));
      track.scrollTo({ left: slides[n].offsetLeft - track.offsetLeft, behavior: 'smooth' });
    };
    const update = () => {
      current = Math.round(track.scrollLeft / Math.max(1, track.clientWidth));
      dots.forEach((d, i) => (i === current ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
      if (prev) prev.disabled = current === 0;
      if (next) next.disabled = current === slides.length - 1;
    };

    prev?.addEventListener('click', () => go(current - 1));
    next?.addEventListener('click', () => go(current + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
    track.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') go(current - 1);
      if (e.key === 'ArrowRight') go(current + 1);
    });
    update();
  });
</script>
