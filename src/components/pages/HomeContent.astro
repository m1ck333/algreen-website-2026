---
import { useTranslations } from '../../i18n/ui';
import { path } from '../../i18n/routes';
import { company, type Lang } from '../../i18n/config';
import CtaBand from '../CtaBand.astro';
import FaqSection from '../FaqSection.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const s = t.home.showcase;

// Full-bleed hero mosaic (2×2 on mobile, 4-across on desktop).
const heroImages = [
  { src: '/img/design/hero-house.webp', alt: 'Algreen — moderna kuća sa aluminijumskim ulaznim vratima' },
  { src: '/img/design/hero-door.webp', alt: 'Algreen — ekskluzivna ulazna vrata' },
  { src: '/img/design/hero-pivot.webp', alt: 'Algreen — pivot ulazna vrata' },
  { src: '/img/design/access-control.webp', alt: 'Algreen — kontrola pristupa' },
];

// Destinations for the four "exclusive doors" tiles (order matches s.tiles).
const tileHrefs = [
  '/files/Katalog ulaznih vrata 2024.pdf',
  path('equipment', lang),
  path('equipment', lang),
  path('technical', lang),
];

// Works gallery — door photography from the 2026 design set.
const works = [
  '/img/design/work-1.webp',
  '/img/design/hero-door.webp',
  '/img/design/work-2.webp',
  '/img/design/work-3.webp',
  '/img/design/work-4.webp',
  '/img/design/work-5.webp',
];
---

<!-- HERO — full-bleed photo mosaic with the wordmark -->
<section class="relative min-h-[92svh] overflow-hidden bg-ink-900">
  <div class="absolute inset-0 grid grid-cols-2 grid-rows-2 lg:grid-cols-4 lg:grid-rows-1">
    {
      heroImages.map((img) => (
        <img
          src={img.src}
          alt={img.alt}
          width="1400"
          height="1000"
          fetchpriority="high"
          loading="eager"
          decoding="async"
          class="h-full w-full object-cover"
        />
      ))
    }
  </div>
  <div class="absolute inset-0 bg-ink-900/55"></div>
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink-900 via-transparent to-ink-900/40"></div>

  <div class="relative z-10 flex min-h-[92svh] flex-col items-center justify-center px-5 text-center">
    <img
      src="/img/logo-white.png"
      alt="Algreen"
      width="360"
      height="102"
      class="w-56 animate-fade-up sm:w-72 lg:w-80"
    />
    <h1
      class="mt-7 max-w-md animate-fade-up text-[0.7rem] font-semibold uppercase tracking-[0.32em] text-white/80 sm:text-xs"
      style="animation-delay:.15s"
    >
      {t.home.heroEyebrow} {t.home.heroTitle}
    </h1>
    <a href={company.configurator} target="_blank" rel="noopener" class="btn-primary mt-9 animate-fade-up" style="animation-delay:.3s">
      {s.configCta}
    </a>
  </div>

  <div class="absolute bottom-7 left-1/2 z-10 -translate-x-1/2 text-white/50">
    <svg class="h-7 w-7 animate-scroll-cue" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
  </div>
</section>

<!-- CONFIGURATOR — Kreirajte svoja vrata -->
<section class="bg-ink-900 py-20 text-white sm:py-28">
  <div class="container-px grid items-center gap-12 lg:grid-cols-2">
    <div class="reveal">
      <p class="eyebrow text-accent">{s.configKicker}</p>
      <h2 class="text-4xl font-bold uppercase leading-[1.05] tracking-tight sm:text-5xl">{s.configHeading}</h2>
      <p class="mt-6 max-w-lg leading-relaxed text-white/70">{s.configText}</p>
      <a href={company.configurator} target="_blank" rel="noopener" class="btn-primary mt-9">{s.configCta}</a>
    </div>
    <div class="reveal" data-delay="2">
      <img
        src="/img/design/configurator.webp"
        alt={s.configHeading}
        loading="lazy"
        width="1792"
        height="915"
        class="w-full rounded shadow-luxe-lg ring-1 ring-white/10"
      />
    </div>
  </div>
</section>

<!-- EXCLUSIVE DOORS — category tiles -->
<section class="bg-ink-900 pb-2">
  <div class="container-px pb-12 text-center reveal">
    <h2 class="text-3xl font-bold uppercase tracking-tight text-white sm:text-4xl">{s.doorsHeading}</h2>
    <div class="mx-auto mt-6 h-px w-16 bg-accent"></div>
  </div>
  <div class="grid grid-cols-2 gap-1 lg:grid-cols-4">
    {
      s.tiles.map((tile, i) => (
        <a
          href={tileHrefs[i]}
          target={tileHrefs[i].endsWith('.pdf') ? '_blank' : undefined}
          rel={tileHrefs[i].endsWith('.pdf') ? 'noopener' : undefined}
          class="group mosaic-tile aspect-[4/5] reveal"
          data-delay={String((i % 4) + 1)}
        >
          <img src={tile.img} alt={tile.label} loading="lazy" width="700" height="875" />
          <span class="mosaic-label">{tile.label}</span>
        </a>
      ))
    }
  </div>
</section>

<!-- OFFER — Naša ponuda manifesto -->
<section class="bg-ink-900 py-24 sm:py-32">
  <div class="container-px mx-auto max-w-3xl text-center reveal">
    <p class="eyebrow eyebrow-center text-accent">{s.offerKicker}</p>
    <p class="text-2xl font-medium leading-snug text-white sm:text-3xl">{s.offerText}</p>
    <p class="mt-8 text-sm font-semibold uppercase tracking-[0.28em] text-accent">{s.offerSoon}</p>
  </div>
</section>

<!-- PRODUCT MOSAIC — full range -->
<section class="bg-ink-900">
  <div class="grid grid-cols-2 gap-1 lg:grid-cols-3">
    {
      s.products.map((p, i) => (
        <figure class="group mosaic-tile aspect-[4/5] reveal" data-delay={String((i % 3) + 1)}>
          <img src={p.img} alt={p.label} loading="lazy" width="700" height="875" />
          <figcaption class="mosaic-label">{p.label}</figcaption>
        </figure>
      ))
    }
  </div>
</section>

<!-- WORKS — Naši radovi -->
<section class="bg-ink-900 py-20 sm:py-28">
  <div class="container-px mb-12 text-center reveal">
    <h2 class="text-3xl font-bold uppercase tracking-tight text-white sm:text-4xl">{s.worksHeading}</h2>
    <div class="mx-auto mt-6 h-px w-16 bg-accent"></div>
  </div>
  <div class="grid grid-cols-2 gap-1 lg:grid-cols-3">
    {
      works.map((src, i) => (
        <figure class="group mosaic-tile aspect-[3/4] reveal" data-delay={String((i % 3) + 1)}>
          <img src={src} alt="Algreen — realizovani projekat" loading="lazy" width="700" height="933" />
        </figure>
      ))
    }
  </div>
  <div class="container-px mt-12 text-center reveal">
    <a href={path('works', lang)} class="btn-outline border-white/25 text-white hover:border-accent hover:text-accent">
      {s.worksCta}
    </a>
  </div>
</section>

<FaqSection lang={lang} />

<CtaBand lang={lang} variant="configurator" />
