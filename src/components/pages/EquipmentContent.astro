---
import { useTranslations } from '../../i18n/ui';
import { company, type Lang } from '../../i18n/config';
import { img } from '../../lib/slots';
import PageHero from '../PageHero.astro';
import CtaBand from '../CtaBand.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// Small visual galleries reused from the legacy asset set.
const handles = [1, 2, 3, 4, 5, 6].map((i) => img(`equipment.handle.${i}`));
const locks = [1, 2, 3, 4, 5, 6].map((i) => img(`equipment.lock.${i}`));
const categoryImages = t.equipment.categories.map((_, i) => img(`equipment.category.${i + 1}`));
const fingerprint = img('equipment.fingerprint');
const mailbox = img('equipment.mailbox');
---

<PageHero title={t.equipment.title} subtitle={t.equipment.subtitle} eyebrow={t.nav.equipment} image={img('hero.equipment')} />

<!-- Intro -->
<section class="section">
  <div class="container-px reveal">
    <h2 class="max-w-3xl text-3xl font-semibold text-white sm:text-4xl">{t.equipment.subtitle}</h2>
    <p class="mt-5 max-w-3xl leading-relaxed text-white/70">{t.equipment.intro}</p>
  </div>

  <!-- Categories -->
  <div class="container-px mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {
      t.equipment.categories.map((c, i) => (
        <article class="group overflow-hidden rounded-2xl bg-white/[0.04] ring-1 ring-white/10 transition-all duration-300 hover:-translate-y-1.5 hover:bg-white/[0.07] reveal">
          <div class="aspect-square overflow-hidden bg-white">
            <img src={categoryImages[i].src} srcset={categoryImages[i].srcset} sizes={categoryImages[i].srcset && '(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw'} alt={c.title} loading="lazy" class="h-full w-full object-contain p-8 transition-transform duration-500 group-hover:scale-105" />
          </div>
          <div class="border-t border-white/10 p-6">
            <h3 class="text-lg font-semibold text-white">{c.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-white/70">{c.text}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>

<!-- Visual strips -->
<section class="bg-ink-800 section">
  <div class="container-px space-y-12">
    <div class="reveal">
      <h3 class="mb-6 text-2xl font-semibold text-white">{t.equipment.categories[1].title}</h3>
      <div class="grid grid-cols-3 gap-4 sm:grid-cols-6">
        {handles.map((h) => (
          <div class="group flex aspect-square items-center justify-center rounded-xl bg-white p-4 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:ring-2 hover:ring-accent/40">
            <img src={h.src} srcset={h.srcset} sizes={h.srcset && '(min-width: 640px) 16vw, 33vw'} alt="" loading="lazy" class="max-h-full w-auto object-contain transition-transform duration-500 group-hover:scale-110" />
          </div>
        ))}
      </div>
    </div>
    <div class="reveal">
      <h3 class="mb-6 text-2xl font-semibold text-white">{t.equipment.categories[0].title}</h3>
      <div class="grid grid-cols-3 gap-4 sm:grid-cols-6">
        {locks.map((h) => (
          <div class="group flex aspect-square items-center justify-center rounded-xl bg-white p-4 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:ring-2 hover:ring-accent/40">
            <img src={h.src} srcset={h.srcset} sizes={h.srcset && '(min-width: 640px) 16vw, 33vw'} alt="" loading="lazy" class="max-h-full w-auto object-contain transition-transform duration-500 group-hover:scale-110" />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- Smart access control -->
<section class="section">
  <div class="container-px">
    <div class="mx-auto mb-12 max-w-2xl text-center reveal">
      <p class="eyebrow">{t.equipment.categories[2].title}</p>
      <h2 class="text-3xl font-semibold text-white sm:text-4xl">{t.equipment.accessHeading}</h2>
    </div>
    <div class="grid items-center gap-10 lg:grid-cols-2">
      <div class="group overflow-hidden rounded-2xl reveal">
        <img src={fingerprint.src} srcset={fingerprint.srcset} sizes={fingerprint.srcset && '(min-width: 1024px) 50vw, 100vw'} alt={t.equipment.fingerprint} loading="lazy" class="w-full bg-ink-900 object-contain p-10 transition-transform duration-700 ease-out group-hover:scale-105" />
      </div>
      <div class="reveal">
        <h3 class="text-2xl font-semibold text-white">{t.equipment.fingerprint}</h3>
        <div class="mt-8">
          <h4 class="text-lg font-semibold text-accent">{t.equipment.voiceAssistant}</h4>
          <ul class="mt-4 space-y-3">
            {
              t.equipment.voiceBullets.map((b) => (
                <li class="flex gap-3 text-white/70">
                  <svg class="mt-1 h-5 w-5 shrink-0 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                  <span>{b}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Mailbox -->
<section class="bg-ink-800 section">
  <div class="container-px grid items-center gap-10 lg:grid-cols-2">
    <div class="reveal">
      <p class="eyebrow">{t.equipment.categories[3].title}</p>
      <h2 class="text-3xl font-semibold text-white sm:text-4xl">{t.equipment.boxHeading}</h2>
      <p class="mt-5 leading-relaxed text-white/70">{t.equipment.boxText}</p>
      <a href={company.configurator} target="_blank" rel="noopener" class="btn-primary mt-8">{t.common.configurator}</a>
    </div>
    <div class="group overflow-hidden rounded-2xl shadow-xl reveal">
      <img src={mailbox.src} srcset={mailbox.srcset} sizes={mailbox.srcset && '(min-width: 1024px) 50vw, 100vw'} alt={t.equipment.boxHeading} loading="lazy" class="w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" />
    </div>
  </div>
</section>

<CtaBand lang={lang} variant="configurator" />
