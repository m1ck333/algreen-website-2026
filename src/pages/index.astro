---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeContent from '../components/pages/HomeContent.astro';
import { useTranslations } from '../i18n/ui';
import { img } from '../lib/slots';
const lang = 'sr' as const;
const t = useTranslations(lang);

// Preload the LCP image (first hero tile — follows its admin replacement).
const hero = img('home.hero.1');
const heroPreload = [{ href: hero.src, imagesrcset: hero.srcset, imagesizes: '(min-width: 1024px) 25vw, 50vw' }];
---

<BaseLayout lang={lang} routeKey="home" title={t.home.metaTitle} description={t.home.metaDescription} preloadImages={heroPreload}>
  <HomeContent lang={lang} />
</BaseLayout>
