---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeContent from '../components/pages/HomeContent.astro';
import { useTranslations } from '../i18n/ui';
const lang = 'sr' as const;
const t = useTranslations(lang);

const heroPreload = [
  '/img/design/hero-house.webp',
  '/img/design/hero-door.webp',
  '/img/design/hero-pivot.webp',
  '/img/design/access-control.webp',
];
---

<BaseLayout lang={lang} routeKey="home" title={t.home.metaTitle} description={t.home.metaDescription} preloadImages={heroPreload}>
  <HomeContent lang={lang} />
</BaseLayout>
